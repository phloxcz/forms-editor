# Normalize line endings
* text=auto eol=lf
*.php text eol=lf
*.js  text eol=lf
*.css text eol=lf
*.md  text eol=lf

# Files/dirs excluded from Packagist export (composer install --prefer-dist)
/.github            export-ignore
/tests              export-ignore
/demo               export-ignore
/phpstan.neon       export-ignore
/.gitignore         export-ignore
/.gitattributes     export-ignore
/CHANGELOG.md       export-ignore
