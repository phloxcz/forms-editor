{
    "name": "phloxcz/forms-editor",
    "description": "Full-featured WYSIWYG editor form control for Nette Framework with Bootstrap 5.3 Grid builder, image upload, source view and more.",
    "keywords": [
        "nette",
        "wysiwyg",
        "editor",
        "form",
        "bootstrap",
        "grid",
        "richtext",
        "html-editor",
        "nette-forms",
        "nette-extension"
    ],
    "homepage": "https://github.com/phloxcz/forms-editor",
    "license": "MIT",
    "authors": [
        {
            "name": "Phlox",
            "homepage": "https://github.com/phloxcz",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "nette/forms": "^3.1",
        "nette/di": "^3.1",
        "nette/http": "^3.2",
        "nette/utils": "^4.0"
    },
    "require-dev": {
        "nette/tester": "^2.5",
        "phpstan/phpstan": "^1.11",
        "phpstan/phpstan-nette": "^1.3",
        "nette/bootstrap": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Phlox\\Forms\\Editor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Phlox\\Forms\\Editor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/tester tests/ -C",
        "phpstan": "vendor/bin/phpstan analyse --level=8",
        "check": [
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "extra": {
        "nette": {
            "config": "config/wysiwyg.neon"
        }
    },
    "support": {
        "issues": "https://github.com/phloxcz/forms-editor/issues",
        "source": "https://github.com/phloxcz/forms-editor"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}